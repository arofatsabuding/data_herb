# คัดลอกเป็น .env แล้วใส่ค่าจริง (.env ไม่ขึ้น git)

# รหัสยืนยันสำหรับปุ่ม "ดึงรายงาน ณ ปัจจุบัน" ในหน้า /kpi (ถามรหัสจากผู้ดูแล)
FETCH_NOW_CODE=

# รหัสเข้าหน้า /admin (เมนู "ผู้ดูแล") — ไม่ตั้ง = ใช้รหัสที่กำหนดไว้ใน lib/admin-auth.js
# ADMIN_PAGE_CODE=

# รหัสผู้ดูแลสำหรับอัปโหลดไฟล์อ้างอิงในหน้า /admin (ไม่ตั้ง = ใช้ FETCH_NOW_CODE)
# ADMIN_CODE=

# ดึงข้อมูลอัตโนมัติทุกวัน 22:00 — ไม่ตั้ง = ดึงเฉพาะ npm start (เซิร์ฟเวอร์จริง), npm run dev ไม่ดึง
# on / off = บังคับเปิด/ปิด
# OPENDATA_CRON=off
# OPENDATA_CRON_TIME=0 22 * * *

# ปีที่ส่งให้ API: auto = ใช้ 2570 เมื่อ API มีข้อมูล ถ้ายังไม่มีใช้ OPENDATA_FALLBACK_YEAR แทน
# OPENDATA_FETCH_YEAR=auto
# OPENDATA_FALLBACK_YEAR=2569

# จำนวนไฟล์ (dataset) ที่เก็บในฐานข้อมูลพร้อมกัน
# KPI_MAX_DATASETS=12

# จำนวนปีงบประมาณล่าสุดที่เทียบกันเมื่อผู้ใช้ยังไม่ได้เลือกปีเอง (ค่าเริ่มต้น 2)
# ผู้ใช้ติ๊กเลือกปีเองได้ในหน้า /kpi, API ใช้ ?years=2568,2570
# KPI_COMPARE_YEARS=2

# แชท AI ในหน้าเว็บ (ปุ่ม "ถาม AI") — ไม่ตั้ง ANTHROPIC_API_KEY = ไม่แสดงปุ่ม
# สร้าง key ได้ที่ https://platform.claude.com/ (มีค่าใช้จ่ายตามการใช้งาน)
# ANTHROPIC_API_KEY=
# CHAT_MODEL=claude-opus-5-5
# ข้อความต่อ IP ต่อชั่วโมง / ข้อความรวมทั้งเว็บต่อวัน
# CHAT_PER_IP=20
# CHAT_PER_DAY=500
# ตั้งเป็น 0 = ปิดแชทชั่วคราวโดยไม่ต้องลบ key
# CHAT_ENABLED=0
