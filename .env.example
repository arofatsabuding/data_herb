# คัดลอกเป็น .env แล้วใส่ค่าจริง (.env ไม่ขึ้น git)

# รหัสยืนยันสำหรับปุ่ม "ดึงรายงาน ณ ปัจจุบัน" ในหน้า /kpi (ถามรหัสจากผู้ดูแล)
FETCH_NOW_CODE=

# รหัสเข้าหน้า /admin (เมนู "ผู้ดูแล") — ไม่ตั้ง = ใช้รหัสที่กำหนดไว้ใน lib/admin-auth.js
# ADMIN_PAGE_CODE=

# รหัสผู้ดูแลสำหรับอัปโหลดไฟล์อ้างอิงในหน้า /admin (ไม่ตั้ง = ใช้ FETCH_NOW_CODE)
# ADMIN_CODE=

# ดึงข้อมูลอัตโนมัติทุกวัน 22:00 — off = ปิด (เช่น เครื่องทีมที่รัน dev)
# OPENDATA_CRON=off
# OPENDATA_CRON_TIME=0 22 * * *

# ปีที่ส่งให้ API: auto = ใช้ 2570 เมื่อ API มีข้อมูล ถ้ายังไม่มีใช้ OPENDATA_FALLBACK_YEAR แทน
# OPENDATA_FETCH_YEAR=auto
# OPENDATA_FALLBACK_YEAR=2569

# จำนวนไฟล์ (dataset) ที่เก็บในฐานข้อมูลพร้อมกัน
# KPI_MAX_DATASETS=12
